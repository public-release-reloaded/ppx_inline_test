opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_inline_test"
bug-reports: "https://github.com/public-release-reloaded/ppx_inline_test/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_inline_test.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_inline_test/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "basement" {>= "v0.18~" & < "v0.19~"}
  "ppxlib_jane" {>= "v0.18~" & < "v0.19~"}
  "sexplib0" {>= "v0.18~" & < "v0.19~"}
  "time_now" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {>= "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Syntax extension for writing in-line tests in ocaml code"
description: "
Part of the Jane Street's PPX rewriters collection.
"
